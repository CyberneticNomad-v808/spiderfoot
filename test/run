#!/usr/bin/env bash
#
# SpiderFoot Test Runner - Simple No-Hang Version
#
# This is a simplified test runner that avoids database configuration issues
# and hanging problems by using sensible defaults and minimal complexity.

set -euo pipefail

# Trap Ctrl+C to exit gracefully  
trap 'echo -e "\n\n[INTERRUPTED] Test execution stopped by user"; exit 130' SIGINT SIGTERM

# Script setup
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Configuration variables
verbose_mode=false
config_file=""

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

log_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

log_fatal() {
    local message="$1"
    local exit_code="${2:-1}"
    echo -e "${RED}[FATAL]${NC} ${message}" >&2
    exit "${exit_code}"
}

header() {
    local title="$1"
    echo ""
    echo -e "${BLUE}============================================${NC}"
    echo -e "${BLUE}  ${title}${NC}"
    echo -e "${BLUE}============================================${NC}"
    echo ""
}

command_exists() {
    command -v "$1" &> /dev/null
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Validate and display database configuration
setup_safe_database_env() {
    # PostgreSQL-only configuration (SQLite support removed in bd8df866)
    # Require explicit configuration - no fallbacks

    if [[ -z "${SPIDERFOOT_DB_TYPE:-}" ]]; then
        log_fatal "SPIDERFOOT_DB_TYPE not set. Run option 6 to configure or set environment variables." 2
    fi

    if [[ -z "${SPIDERFOOT_DB_HOST:-}" ]]; then
        log_fatal "SPIDERFOOT_DB_HOST not set. Run option 6 to configure or set environment variables." 2
    fi

    if [[ -z "${SPIDERFOOT_DB_PORT:-}" ]]; then
        log_fatal "SPIDERFOOT_DB_PORT not set. Run option 6 to configure or set environment variables." 2
    fi

    if [[ -z "${SPIDERFOOT_DB_NAME:-}" ]]; then
        log_fatal "SPIDERFOOT_DB_NAME not set. Run option 6 to configure or set environment variables." 2
    fi

    if [[ -z "${SPIDERFOOT_DB_USER:-}" ]]; then
        log_fatal "SPIDERFOOT_DB_USER not set. Run option 6 to configure or set environment variables." 2
    fi

    log_info "Database: PostgreSQL - ${SPIDERFOOT_DB_USER}@${SPIDERFOOT_DB_HOST}:${SPIDERFOOT_DB_PORT}/${SPIDERFOOT_DB_NAME}"
    log_info "Note: Unit tests mock database connections (conftest.py patches psycopg2.connect)"
}

##
# Configure test database settings
##
configure_test_database() {
    header "Test Database Configuration"

    log_info "SpiderFoot uses PostgreSQL database (SQLite support removed in bd8df866)."
    echo ""
    echo "For unit tests, database connections are mocked by conftest.py."
    echo "For integration tests, a real PostgreSQL instance is required."
    echo ""

    echo "Database configuration options:"
    echo "  1) Use default test settings (recommended - matches conftest.py)"
    echo "  2) Configure custom PostgreSQL connection"
    echo "  3) Show current database config"
    echo ""
    echo -n "Select option [1-3]: "
    read -r db_choice

    case "$db_choice" in
        1)
            export SPIDERFOOT_DB_TYPE="postgresql"
            export SPIDERFOOT_DB_HOST="localhost"
            export SPIDERFOOT_DB_PORT="5432"
            export SPIDERFOOT_DB_NAME="spiderfoot_test"
            export SPIDERFOOT_DB_USER="spiderfoot"
            export SPIDERFOOT_DB_PASSWORD=""
            log_info "Configured for default test database (localhost:5432/spiderfoot_test)"
            log_info "Unit tests will mock connections; integration tests need real PostgreSQL"
            ;;
        2)
            echo -n "PostgreSQL host [localhost]: "
            read -r pg_host
            pg_host=${pg_host:-localhost}

            echo -n "PostgreSQL port [5432]: "
            read -r pg_port
            pg_port=${pg_port:-5432}

            echo -n "Database name [spiderfoot_test]: "
            read -r pg_db
            pg_db=${pg_db:-spiderfoot_test}

            echo -n "Username [spiderfoot]: "
            read -r pg_user
            pg_user=${pg_user:-spiderfoot}

            echo -n "Password: "
            read -rs pg_pass
            echo ""

            # Test PostgreSQL connection before setting
            log_info "Testing PostgreSQL connection..."
            if python3 -c "import psycopg2; psycopg2.connect(host='$pg_host', port='$pg_port', database='$pg_db', user='$pg_user', password='$pg_pass')" 2>/dev/null; then
                export SPIDERFOOT_DB_TYPE="postgresql"
                export SPIDERFOOT_DB_HOST="$pg_host"
                export SPIDERFOOT_DB_PORT="$pg_port"
                export SPIDERFOOT_DB_NAME="$pg_db"
                export SPIDERFOOT_DB_USER="$pg_user"
                export SPIDERFOOT_DB_PASSWORD="$pg_pass"
                log_info "PostgreSQL connection successful: $pg_user@$pg_host:$pg_port/$pg_db"
            else
                log_warn "PostgreSQL connection failed, using defaults (tests will be mocked)"
                export SPIDERFOOT_DB_TYPE="postgresql"
                export SPIDERFOOT_DB_HOST="localhost"
                export SPIDERFOOT_DB_PORT="5432"
                export SPIDERFOOT_DB_NAME="spiderfoot_test"
                export SPIDERFOOT_DB_USER="spiderfoot"
                export SPIDERFOOT_DB_PASSWORD=""
            fi
            ;;
        3)
            echo "Current database configuration:"
            echo "  SPIDERFOOT_DB_TYPE: ${SPIDERFOOT_DB_TYPE:-(not set)}"
            echo "  SPIDERFOOT_DB_HOST: ${SPIDERFOOT_DB_HOST:-(not set)}"
            echo "  SPIDERFOOT_DB_PORT: ${SPIDERFOOT_DB_PORT:-(not set)}"
            echo "  SPIDERFOOT_DB_NAME: ${SPIDERFOOT_DB_NAME:-(not set)}"
            echo "  SPIDERFOOT_DB_USER: ${SPIDERFOOT_DB_USER:-(not set)}"
            echo "  SPIDERFOOT_DB_PASSWORD: ${SPIDERFOOT_DB_PASSWORD:+***set***}"
            [[ -z "${SPIDERFOOT_DB_PASSWORD:-}" ]] && echo "                      (not set)"
            ;;
        *)
            log_error "Invalid selection"
            ;;
    esac

    echo ""
    echo "Press Enter to continue..."
    read -r
}

run_unit_tests() {
    header "Running Unit Tests"
    log_info "Running unit tests only..."

    cd "${PROJECT_ROOT}" || { log_error "Cannot change to project root"; exit 1; }
    setup_safe_database_env

    local pytest_args=("test/unit/" "--tb=short" "--maxfail=10")

    if [[ "${verbose_mode}" == true ]]; then
        pytest_args+=("-v")
    fi

    # Add user arguments
    if [[ $# -gt 0 ]]; then
        pytest_args+=("$@")
    fi

    log_info "Press Ctrl+C to interrupt tests"

    if command -v pytest >/dev/null 2>&1; then
        pytest "${pytest_args[@]}"
    else
        python3 -m pytest "${pytest_args[@]}"
    fi
}

##
# Display interactive menu
##
show_menu() {
    clear
    header "SpiderFoot Test Runner Menu"

    # Show current database configuration
    if [[ -n "${SPIDERFOOT_DB_NAME:-}" ]]; then
        echo -e "${BLUE}Database:${NC} PostgreSQL ${SPIDERFOOT_DB_USER}@${SPIDERFOOT_DB_HOST}:${SPIDERFOOT_DB_PORT}/${SPIDERFOOT_DB_NAME}"
        echo -e "${BLUE}Note:${NC} Unit tests use mocked connections (conftest.py)"
    else
        echo -e "${RED}Database:${NC} NOT CONFIGURED - Select option 6 to configure"
    fi
    echo ""

    echo -e "${GREEN}Available Test Commands:${NC}"
    echo "  1) Unit Tests Only          (test/unit/ - fast, mocked DB)"
    echo "  2) Standard Tests           (excludes module integration)"
    echo "  3) All Tests                (includes everything - may be slow)"
    echo "  4) Module Integration Tests (external API tests)"
    echo ""
    echo -e "${YELLOW}Configuration:${NC}"
    echo "  5) Check Test Environment"
    echo "  6) Configure Test Database"
    echo ""
    echo -e "${BLUE}Options:${NC}"
    echo "  7) Help & Documentation"
    echo "  8) Version Information"
    echo "  q) Quit"
    echo ""
    echo -e "${YELLOW}Note:${NC} Press Ctrl+C during test execution to interrupt"
    echo ""
    echo -n "Select an option [1-8,q]: "
}

##
# Handle menu selection
##
handle_menu_selection() {
    local choice="$1"
    
    case "$choice" in
        1)
            echo -e "\n${GREEN}Running Unit Tests...${NC}"
            run_unit_tests
            ;;
        2)
            echo -e "\n${GREEN}Running Standard Tests...${NC}"
            run_standard_tests
            ;;
        3)
            echo -e "\n${YELLOW}Warning: This may take a long time and requires external services${NC}"
            echo -n "Continue? [y/N]: "
            read -r confirm
            if [[ "$confirm" =~ ^[Yy]$ ]]; then
                echo -e "\n${GREEN}Running All Tests...${NC}"
                run_all_tests
            else
                echo "Cancelled."
            fi
            ;;
        4)
            echo -e "\n${YELLOW}Warning: Module tests require API keys and external services${NC}"
            echo -n "Continue? [y/N]: "
            read -r confirm
            if [[ "$confirm" =~ ^[Yy]$ ]]; then
                echo -e "\n${GREEN}Running Module Integration Tests...${NC}"
                run_module_tests
            else
                echo "Cancelled."
            fi
            ;;
        5)
            check_test_environment
            ;;
        6)
            configure_test_database
            ;;
        7)
            show_help
            ;;
        8)
            show_version
            ;;
        q|Q)
            echo "Goodbye!"
            exit 0
            ;;
        *)
            echo -e "${RED}Invalid selection: $choice${NC}"
            ;;
    esac
}

run_standard_tests() {
    header "Running Standard Tests"
    log_info "Running unit and integration tests (excluding modules)..."

    cd "${PROJECT_ROOT}" || log_fatal "Failed to change to project root: ${PROJECT_ROOT}" 1
    setup_safe_database_env

    local pytest_args=("--ignore=test/integration/modules/" "--tb=short")

    if [[ "${verbose_mode}" == true ]]; then
        pytest_args+=("-v")
    fi

    log_info "Starting unit tests... (Press Ctrl+C to interrupt)"
    
    # Run pytest in foreground so signals are properly handled
    if command_exists "pytest"; then
        exec pytest "${pytest_args[@]}"
    else  
        exec python3 -m pytest "${pytest_args[@]}"
    fi
}

run_all_tests() {
    header "Running All Tests"
    log_info "Running all tests including module integration tests..."

    cd "${PROJECT_ROOT}" || log_fatal "Failed to change to project root: ${PROJECT_ROOT}" 1
    setup_safe_database_env

    local pytest_args=("--tb=short")

    if [[ "${verbose_mode}" == true ]]; then
        pytest_args+=("-v")
    fi

    log_info "Starting tests... (Press Ctrl+C to interrupt)"
    
    if command_exists "pytest"; then
        pytest "${pytest_args[@]}"
    else
        python3 -m pytest "${pytest_args[@]}"
    fi
}

run_module_tests() {
    header "Running Module Integration Tests"
    log_info "Running module integration tests only..."

    cd "${PROJECT_ROOT}" || log_fatal "Failed to change to project root: ${PROJECT_ROOT}" 1
    setup_safe_database_env

    local pytest_args=("test/integration/modules/" "--tb=short")

    if [[ "${verbose_mode}" == true ]]; then
        pytest_args+=("-v")
    fi

    log_info "Starting tests... (Press Ctrl+C to interrupt)"
    
    if command_exists "pytest"; then
        pytest "${pytest_args[@]}"
    else
        python3 -m pytest "${pytest_args[@]}"
    fi
}

check_test_environment() {
    header "Test Environment Check"
    
    log_info "Checking SpiderFoot project structure..."
    if [[ -f "${PROJECT_ROOT}/sf.py" ]]; then
        echo -e "  ✓ Main SpiderFoot file found"
    else
        echo -e "  ✗ Main SpiderFoot file missing"
    fi
    
    log_info "Checking Python environment..."
    if command_exists "python3"; then
        python_version=$(python3 --version 2>&1)
        echo -e "  ✓ Python: $python_version"
    else
        echo -e "  ✗ Python 3 not found"
    fi
    
    log_info "Checking pytest installation..."
    if command_exists "pytest"; then
        pytest_version=$(pytest --version 2>&1 | head -1)
        echo -e "  ✓ Pytest command: $pytest_version"
    elif python3 -m pytest --version &>/dev/null; then
        pytest_version=$(python3 -m pytest --version 2>&1 | head -1)
        echo -e "  ✓ Pytest module: $pytest_version"
    else
        echo -e "  ✗ Pytest not found"
    fi
    
    log_info "Checking test directories..."
    local test_dirs=("test/unit" "test/integration" "test/integration/modules")
    for dir in "${test_dirs[@]}"; do
        if [[ -d "${PROJECT_ROOT}/$dir" ]]; then
            test_count=$(find "${PROJECT_ROOT}/$dir" -name "test_*.py" | wc -l)
            echo -e "  ✓ $dir ($test_count test files)"
        else
            echo -e "  ✗ $dir not found"
        fi
    done
    
    log_info "Checking database configuration..."
    if [[ -f "${PROJECT_ROOT}/spiderfoot_db.py" ]]; then
        echo -e "  ✓ Database module found"
        # Check if PostgreSQL settings exist
        if grep -q "postgresql" "${PROJECT_ROOT}/spiderfoot_db.py" 2>/dev/null; then
            echo -e "  ✓ PostgreSQL support detected"
        else
            echo -e "  ⚠ PostgreSQL support not clearly detected"
        fi
    else
        echo -e "  ✗ Database module not found"
    fi
    
    echo ""
    echo "Press Enter to continue..."
    read -r
}

show_version() {
    echo "SpiderFoot Test Runner version 1.0.0"
}

show_help() {
    cat << EOF
Usage: $0 [OPTIONS] [COMMAND]

DESCRIPTION:
    SpiderFoot Unit and Integration Test Runner

    Run without arguments for interactive menu mode.
    This script runs SpiderFoot's test suites using pytest with
    configurable database backends and test filtering.

COMMANDS:
    test            Run standard tests (excludes module integration tests)
    unit            Run only unit tests
    all             Run all tests including module integration tests
    modules         Run only module integration tests
    help            Show this help message

OPTIONS:
    -v, --verbose   Enable verbose pytest output
    -h, --help      Show this help message

EXAMPLES:
    $0              # Show interactive menu
    $0 unit         # Run unit tests only
    $0 test         # Run standard tests
    $0 all          # Run all tests including modules
    $0 -v modules   # Run module tests with verbose output

EXIT CODES:
    0   All tests passed
    1   Tests failed or general error
    2   Invalid arguments or configuration
    3   Required dependency missing (python3, pytest)

For more information, see test/README.md
EOF
}

main() {
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -v|--verbose)
                verbose_mode=true
                shift
                ;;
            -h|--help)
                show_help
                exit 0
                ;;
            test|unit|all|modules|help)
                # These are commands, stop parsing
                break
                ;;
            -*)
                # Pass through pytest options
                break
                ;;
            *)
                # Non-option argument, stop parsing
                break
                ;;
        esac
    done
    
    # Check basic requirements
    if [[ ! -f "${PROJECT_ROOT}/sf.py" ]]; then
        log_error "SpiderFoot not found in ${PROJECT_ROOT}"
        exit 1
    fi
    
    if ! command -v python3 >/dev/null 2>&1; then
        log_error "Python 3 not found"
        exit 1
    fi
    
    if ! python3 -m pytest --version >/dev/null 2>&1 && ! command -v pytest >/dev/null 2>&1; then
        log_error "pytest not found" 
        exit 1
    fi
    
    # Dispatch command or show menu
    local command="${1:-}"
    case "$command" in
        test)
            shift
            run_standard_tests "$@"
            ;;
        unit)
            shift
            run_unit_tests "$@"
            ;;
        all)
            shift
            run_all_tests "$@"
            ;;
        modules)
            shift
            run_module_tests "$@"
            ;;
        help)
            show_help
            ;;
        "")
            # No command given, show interactive menu
            while true; do
                show_menu
                read -r choice
                echo ""
                handle_menu_selection "$choice"
                
                if [[ "$choice" != "q" && "$choice" != "Q" ]]; then
                    echo ""
                    echo "Press Enter to return to menu..."
                    read -r
                else
                    break
                fi
            done
            ;;
        *)
            # Treat as pytest arguments for unit tests
            run_unit_tests "$@"
            ;;
    esac
}

main "$@"

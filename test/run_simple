#!/usr/bin/env bash
#
# Simple SpiderFoot Test Runner - No Hanging Version

set -euo pipefail

# Trap Ctrl+C to exit gracefully
trap 'echo -e "\n\n[INTERRUPTED] Test execution stopped by user"; exit 130' SIGINT SIGTERM

# Script setup
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

log_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

# Set safe database defaults to prevent hanging
setup_safe_database_env() {
    # Force SQLite mode to avoid PostgreSQL connection attempts
    export SF_DB_TYPE="sqlite"
    export SPIDERFOOT_DB_TYPE="sqlite" 
    export SF_DB_PATH="${PROJECT_ROOT}/test_spiderfoot.db"
    export SPIDERFOOT_DB_PATH="${PROJECT_ROOT}/test_spiderfoot.db"
    
    # Clear PostgreSQL variables that cause hanging
    unset SF_PG_HOST SF_PG_PORT SF_PG_DB SF_PG_USER SF_PG_PASS 2>/dev/null || true
    unset SPIDERFOOT_PG_HOST SPIDERFOOT_PG_PORT SPIDERFOOT_PG_DB 2>/dev/null || true
    unset SPIDERFOOT_PG_USER SPIDERFOOT_PG_PASS 2>/dev/null || true
    
    log_info "Database: SQLite (safe mode)"
}

run_tests() {
    log_info "Running SpiderFoot unit tests..."
    
    cd "${PROJECT_ROOT}" || exit 1
    setup_safe_database_env
    
    local args=(
        "test/unit/"
        "--tb=short" 
        "--maxfail=5"
        "--ignore=test/unit/modules/test_sfp__stor_db.py"
    )
    
    # Add user arguments
    args+=("$@")
    
    log_info "Press Ctrl+C to interrupt tests"
    
    if command -v pytest >/dev/null 2>&1; then
        pytest "${args[@]}"
    else  
        python3 -m pytest "${args[@]}"
    fi
}

main() {
    if [[ "${1:-}" == "-h" ]]; then
        echo "Usage: $0 [pytest-args]"
        echo "Simple test runner that avoids hanging issues"
        exit 0
    fi
    
    run_tests "$@"
}

main "$@"

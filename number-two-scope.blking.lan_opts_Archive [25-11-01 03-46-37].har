            "text": "<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\">\n    <title>SpiderFoot v5.3.3</title>\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <meta name=\"description\" content=\"SpiderFoot - Open Source Intelligence Automation Tool\">\n    <meta name=\"author\" content=\"poppopjmp\">\n    <link rel=\"icon\" type=\"image/png\" href=\"/static/img/spiderfoot-icon.png\">\n\n    <script type='text/javascript' src='/static/js/spiderfoot.js'></script>\n    <script type='text/javascript' src='/static/js/viz.js'></script>\n\n    <link href=\"/static/css/spiderfoot.css\" rel=\"stylesheet\">\n    <link href=\"/static/node_modules/bootstrap/dist/css/bootstrap.min.css\" rel=\"stylesheet\">\n    <link href=\"/static/node_modules/tablesorter/dist/css/jquery.tablesorter.pager.min.css\" rel=\"stylesheet\">\n    <link href=\"/static/node_modules/alertifyjs/build/css/alertify.min.css\" rel=\"stylesheet\">\n\n    <script>\n        // Load themes before the page body loads\n        var head = document.getElementsByTagName('HEAD')[0];\n        var link = document.createElement('link');\n        link.rel = 'stylesheet';\n        link.type = 'text/css';\n        if (localStorage.getItem(\"theme\") === \"dark-theme\") {\n            link.href = \"/static/css/dark.css\";\n        } else {\n            link.href = \"/static/node_modules/tablesorter/dist/css/theme.default.min.css\";\n        }\n        head.appendChild(link);\n\n      \n    </script>\n  </head>\n\n  <body>\n\n<nav class=\"navbar navbar-fixed-top navbar-default\">\n  <div class=\"container-fluid\">\n    <!-- Brand and toggle get grouped for better mobile display -->\n    <div class=\"navbar-header\">\n      <span data-toggle=\"\" data-target=\"switcher4\">\n      <button type=\"button\" class=\"navbar-toggle collapsed\" data-toggle=\"collapse\" data-target=\"#main-navbar-collapse\" aria-expanded=\"false\">\n        <span class=\"icon-bar\"></span>\n        <span class=\"icon-bar\"></span>\n        <span class=\"icon-bar\"></span>\n      </button>\n    </span>\n      <a class=\"navbar-brand brand-logo light\" href=\"/\"><img class=\"spiderfoot-header-image\" src=\"/static/img/spiderfoot-header.png\" /></a>\n      <a class=\"navbar-brand brand-logo dark\" href=\"/\"><img class=\"spiderfoot-header-image\" src=\"/static/img/spiderfoot-header-dark.png\" /></a>\n    </div>\n\n    <!-- Collect the nav links, forms, and other content for toggling -->\n    <div class=\"collapse navbar-collapse\" id=\"main-navbar-collapse\">      <ul class=\"nav navbar-nav\">\n        <li\nclass=\"nav-item\"\n><a id=\"nav-link-newscan\" href=\"/newscan\"><i class=\"glyphicon glyphicon-screenshot\"></i>&nbsp;New Scan</a></li>\n        <li \nclass=\"nav-item\"\n><a id=\"nav-link-scans\" href=\"/\"><i class=\"glyphicon glyphicon-list\"></i>&nbsp;Scans</a></li>        <li\nclass=\"nav-item\"\n><a id=\"nav-link-workspaces\" href=\"/workspaces\"><i class=\"glyphicon glyphicon-folder-open\"></i>&nbsp;Workspaces</a></li>\n        <li\nclass=\"nav-item\"\n><a id=\"nav-link-docs\" href=\"/documentation/\"><i class=\"glyphicon glyphicon-book\"></i>&nbsp;Documentation</a></li>\n        <li\n    class=\"active\"\nclass=\"nav-item\"><a id=\"nav-link-settings\" href=\"/opts\" class=\"nav-link\"><i class=\"glyphicon glyphicon-wrench\"></i>&nbsp;Settings</a></li>\n \n      </ul>\n\n\n      \n      \n      <ul class=\"nav navbar-nav navbar-right\">\n        <li>\n        <!-- Theme toggler -->\n        <span id=\"toggler-text\">Dark Mode</span>\n        <label id=\"switcher4\" class=\"switch\">\n          <input id=\"theme-toggler\" class=\"theme-toggler\" type=\"checkbox\">\n          <span class=\"slider round\"></span>\n        </label>\n      </li>\n\n        <li class=\"nav-item\"><a href=\"#aboutmodal\" data-toggle=\"modal\" data-target=\"#aboutmodal\"><i class=\"glyphicon glyphicon-info-sign\"></i>&nbsp;About</a></li>\n      </ul>\n    </div><!-- /.navbar-collapse -->\n  </div><!-- /.container-fluid -->\n</nav>\n\n    <div id=\"aboutmodal\" class=\"modal fade\" role=\"dialog\" aria-hidden=\"true\">\n    <div class=\"modal-dialog\" role=\"document\">\n    <div class=\"modal-content\">\n\n    <div class=\"modal-header\">\n      <h3 class=\"modal-title\">SpiderFoot 5.3.3</h3>\n    </div>\n\n    <div class=\"modal-body\">\n    <p>SpiderFoot is an open source, MIT-licensed footprinting tool, created by <a href='https://twitter.com/binarypool' target=_new>Steve Micallef</a>, and actually mantained by <a href='https://twitter.com/van1sh_bsidesit' target=_new>Agostino Panico</a>. It is designed to be easy to use, fast and extensible.</p>\n    <p>If you have any bugs to report, or requests for enhancements, please contact the support mailing list at <a href=mailto:van1sh@van1shland.io>van1sh@van1shland.io</a>.\n    <p>You are running version <b>5.3.3</b>.</p>\n    <p> Check out the Github repo at <a href='https://github.com/poppopjmp/spiderfoot' target=_new>https://github.com/poppopjmp/spiderfoot</a>.</p>\n    <p> Join the community in our <a href='https://discord.gg/vyvztrG' target=_new>Discord Server</a>.</p>\n    </div>\n\n    <div class=\"modal-footer\">\n      <button type=\"button\" class=\"btn btn-primary\" data-dismiss=\"modal\">Close</button>\n    </div>\n\n    </div>\n    </div>\n    </div>\n\n    <!-- Placed at the end of the document so the pages load faster -->\n    <script>var docroot = '';</script>\n    <script>var csrf_token = null;</script>\n    <script src=\"/static/node_modules/jquery/dist/jquery.min.js\"></script>\n    <script src=\"/static/node_modules/bootstrap/dist/js/bootstrap.min.js\"></script>\n    <script src=\"/static/node_modules/alertifyjs/build/alertify.min.js\"></script>\n    <script src=\"/static/node_modules/tablesorter/dist/js/jquery.tablesorter.min.js\"></script>\n    <script src='/static/node_modules/tablesorter/dist/js/extras/jquery.tablesorter.pager.min.js'></script>\n    <script src='/static/node_modules/tablesorter/dist/js/jquery.tablesorter.widgets.min.js'></script>\n    <script src=\"/static/node_modules/d3/d3.min.js\"></script>\n    <script type='text/javascript' hash=\"sha256-0kTZzWMEh3cdgCMVytlY1E8rg7oO13eyLa+kvyAhRmo=\">sf.updateTooltips();</script>\n\n    <div class=\"container\" id=\"mainbody\" style='padding-bottom: 50px'>\n\n\n    <script type='text/javascript' src='/static/js/spiderfoot.opts.js'></script>\n    <h2>Settings</h2>\n\n<form class=\"form\" action='/savesettings' id=\"savesettingsform\" method='POST' enctype=\"multipart/form-data\">\n<div class='text-left'>\n    <input type=hidden id='allopts' name='allopts' value=''>\n    <input type=hidden id='token' name='token' value=\"38142839\">\n    <input type=\"file\" name='configFile' id=\"configFile\" class='hidden' onChange='$(\"#savesettingsform\").submit()' />\n    <button id=\"btn-save-changes\" class='btn btn-primary' type=\"submit\">Save Changes</button>\n    <button id=\"btn-import-config\" class='btn btn-info'>Import API Keys</button>\n    <button id=\"btn-opt-export\" class='btn btn-info'>Export API Keys</button>\n    <button id=\"btn-reset-settings\" class='btn btn-danger'>Reset to Factory Default</button>\n<br><br>\n</div>\n\n<div class=\"tabbable tabs-left\">\n<ul class=\"nav nav-pills nav-stacked col-md-3\">\n<li id='tab_global' class=\"active\"><a href=\"#\">Global</a></li>\n    \n        \n        \n        \n        <li id='tab_sfp_4chan'><a href='#' onclick='switchTab(\"sfp_4chan\");' >4chan Monitor</a></li>\n    \n        \n        \n        \n        <li id='tab_sfp__ai_threat_intel'><a href='#' onclick='switchTab(\"sfp__ai_threat_intel\");' >AI Threat Intelligence Engine</a></li>\n    \n        \n        \n        \n        <li id='tab_sfp__security_hardening'><a href='#' onclick='switchTab(\"sfp__security_hardening\");' >Security Hardening Engine</a></li>\n    \n        \n        \n        \n        <li id='tab_sfp__stor_db'><a href='#' onclick='switchTab(\"sfp__stor_db\");' >Database Storage</a></li>\n    \n        \n        \n        \n        <li id='tab_sfp__stor_db_advanced'><a href='#' onclick='switchTab(\"sfp__stor_db_advanced\");' >Advanced Database Storage (Enterprise)</a></li>\n    \n        \n        \n        \n        <li id='tab_sfp__stor_elasticsearch'><a href='#' onclick='switchTab(\"sfp__stor_elasticsearch\");' >ElasticSearch Storage&nbsp;&nbsp;<i class=\"glyphicon glyphicon-lock\"></i></a></li>\n    \n    \n        \n        \n        \n        <li id='tab_sfp_abstractapi'><a href='#' onclick='switchTab(\"sfp_abstractapi\");' >AbstractAPI&nbsp;&nbsp;<i class=\"glyphicon glyphicon-lock\"></i></a></li>\n    \n        \n        \n        \n        <li id='tab_sfp_abusech'><a href='#' onclick='switchTab(\"sfp_abusech\");' >abuse.ch</a></li>\n    \n        \n        \n        \n        <li id='tab_sfp_abuseipdb'><a href='#' onclick='switchTab(\"sfp_abuseipdb\");' >AbuseIPDB&nbsp;&nbsp;<i class=\"glyphicon glyphicon-lock\"></i></a></li>\n    \n        \n        \n        \n        <li id='tab_sfp_accounts'><a href='#' onclick='switchTab(\"sfp_accounts\");' >Account Finder</a></li>\n    \n        \n        \n        \n        <li id='tab_sfp_adblock'><a href='#' onclick='switchTab(\"sfp_adblock\");' >AdBlock Check</a></li>\n    \n    \n        \n        \n        \n        <li id='tab_sfp_advanced_correlation'><a href='#' onclick='switchTab(\"sfp_advanced_correlation\");' >Advanced Correlation Engine</a></li>\n    \n        \n        \n        \n        <li id='tab_sfp_ahmia'><a href='#' onclick='switchTab(\"sfp_ahmia\");' >Ahmia</a></li>\n    \n        \n        \n        \n        <li id='tab_sfp_ai_summary'><a href='#' onclick='switchTab(\"sfp_ai_summary\");' >AI Threat Intelligence Summarizer&nbsp;&nbsp;<i class=\"glyphicon glyphicon-lock\"></i></a></li>\n    \n        \n        \n        \n        <li id='tab_sfp_alienvault'><a href='#' onclick='switchTab(\"sfp_alienvault\");' >AlienVault OTX&nbsp;&nbsp;<i class=\"glyphicon glyphicon-lock\"></i></a></li>\n    \n        \n        \n        \n        <li id='tab_sfp_alienvaultiprep'><a href='#' onclick='switchTab(\"sfp_alienvaultiprep\");' >AlienVault IP Reputation</a></li>\n    \n        \n        \n        \n        <li id='tab_sfp_aparat'><a href='#' onclick='switchTab(\"sfp_aparat\");' >Aparat Monitor</a></li>\n    \n        \n        \n        \n        <li id='tab_sfp_apileak'><a href='#' onclick='switchTab(\"sfp_apileak\");' >API Key/Secret Leak Detector</a></li>\n    \n    \n        \n        \n        \n        <li id='tab_sfp_arbitrum'><a href='#' onclick='switchTab(\"sfp_arbitrum\");' >Arbitrum Blockchain Monitor&nbsp;&nbsp;<i class=\"glyphicon glyphicon-lock\"></i></a></li>\n    \n        \n        \n        \n        <li id='tab_sfp_archiveorg'><a href='#' onclick='switchTab(\"sfp_archiveorg\");' >Archive.org</a></li>\n    \n    \n        \n        \n        \n        <li id='tab_sfp_azureblobstorage'><a href='#' onclick='switchTab(\"sfp_azureblobstorage\");' >Azure Blob Finder</a></li>\n    \n        \n        \n        \n        <li id='tab_sfp_bambenek'><a href='#' onclick='switchTab(\"sfp_bambenek\");' >Bambenek Consulting</a></li>\n    \n        \n        \n        \n        <li id='tab_sfp_base64'><a href='#' onclick='switchTab(\"sfp_base64\");' >Base64 Decoder</a></li>\n    \n    \n        \n        \n        \n        <li id='tab_sfp_binaryedge'><a href='#' onclick='switchTab(\"sfp_binaryedge\");' >BinaryEdge&nbsp;&nbsp;<i class=\"glyphicon glyphicon-lock\"></i></a></li>\n    \n        \n        \n        \n        <li id='tab_sfp_bingsearch'><a href='#' onclick='switchTab(\"sfp_bingsearch\");' >Bing&nbsp;&nbsp;<i class=\"glyphicon glyphicon-lock\"></i></a></li>\n    \n        \n        \n        \n        <li id='tab_sfp_bingsharedip'><a href='#' onclick='switchTab(\"sfp_bingsharedip\");' >Bing (Shared IPs)&nbsp;&nbsp;<i class=\"glyphicon glyphicon-lock\"></i></a></li>\n    \n        \n  
# Minimal Tor Docker image for SpiderFoot OSINT
FROM alpine:latest

# Install Tor
RUN apk add --no-cache tor netcat-openbsd

# Set up tor directories (user already created by tor package)
RUN mkdir -p /var/lib/tor && \
    chown -R tor:tor /var/lib/tor && \
    chmod 700 /var/lib/tor

# Copy custom torrc if provided
COPY torrc /etc/tor/torrc
RUN chown tor:tor /etc/tor/torrc

# Expose ports
EXPOSE 9050 9051 5353

# Run as tor user
USER tor

# Start Tor
ENTRYPOINT ["tor"]
CMD ["-f", "/etc/tor/torrc"]